{
  "name": "fluid-tower-defense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:red-alert": "node --openssl-legacy-provider scripts/import-red-alert.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:e2e": "vite --host 127.0.0.1 --port 5180 --strictPort --open /tests/e2e/"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
